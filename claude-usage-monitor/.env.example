# ── Admin API de Anthropic (Console / API) ────────────────────────────────
# Clave de administrador (sk-ant-admin...). Créala en Console → Settings → Admin keys.
# Déjala vacía para desactivar el sondeo: el resto del stack funciona igual.
ANTHROPIC_ADMIN_KEY=
POLL_INTERVAL_SECONDS=300
LOOKBACK_DAYS=31

# ── claude.ai (manual) ────────────────────────────────────────────────────
# Precio mensual de tu plan (Pro=20, Max 5x=100, Max 20x=200). Se usa para
# prorratear el "gasto" diario de claude.ai en el panel de superficies.
CLAUDE_AI_PLAN_MONTHLY_USD=20

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Umbrales de alerta
ALERT_BURN_RATE_USD_HR=5
ALERT_DAILY_COST_USD=20
ALERT_CLAUDE_AI_WEEKLY_PCT=90

# Retención de Prometheus
PROMETHEUS_RETENTION=90d
