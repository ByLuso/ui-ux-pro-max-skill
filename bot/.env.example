# ===== Orbital · configuración =====
# Copia este archivo como ".env" y rellena lo que falte. NUNCA compartas tu .env con nadie.

# Qué bot arranca:
#   spot    = radar de Binance + Binance Wallet (BNB Chain) en tiempo real, con cartera de prueba (por defecto)
#   pumpfun = el bot antiguo de lanzamientos de pump.fun
BOT=spot

# --- Radar de Binance + Binance Wallet ---
SPOT_TOP_N=150           # monedas de Binance con más volumen
ALPHA_TOP_N=100          # tokens de Binance Wallet (BNB Chain) con más volumen
ALPHA_MIN_LIQ=100000     # liquidez mínima (dólares)
ALPHA_MIN_VOL=200000     # volumen mínimo en 24 h (dólares)
SPOT_TARGET_ATR=3        # objetivo: 3 veces la volatilidad por hora por encima
SPOT_STOP_ATR=2          # stop: 2 veces por debajo
SPOT_BE_ATR=1.5          # al avanzar 1,5 ATR, el stop sube a la entrada
SPOT_HORIZON_H=72        # horas máximas por operación
SPOT_EV_MIN=0.01         # beneficio esperado mínimo tras costes (+1%)
SPOT_MIN_LABELS=300      # casos aprendidos antes de operar
SPOT_TREND=1             # la cartera opera la estrategia «Tendencia de mercado» (0 = no)
SPOT_TREND_BREADTH=0.75  # compra solo si más de este % de monedas de Binance está sobre su media de 50 h…
SPOT_TREND_WEEK=0.75     # …y más de este % sube en 7 días
SPOT_AGGRO=1             # segunda cartera de prueba «Agresiva» (rotación de momentum); 0 = no
AGGRO_TOP=8              # cuántas monedas mantiene a la vez
AGGRO_EVERY_H=72         # cada tramo cambia de monedas cada estas horas
AGGRO_START_EUR=50       # saldo ficticio inicial de la agresiva
SPOT_MAX_DRAWDOWN=0.25   # freno de emergencia: deja de comprar si la cartera cae este % desde su máximo
SPOT_EXPLORE=0           # compras de prueba con el modelo (desactivado: compraba lo que caía)
SPOT_EXPLORE_EUR=2       # euros ficticios por compra de prueba
BINANCE_FEE=0.001        # comisión de Binance por lado
ALPHA_FEE=0.0025         # comisión estimada de Binance Wallet por lado


# paper = opera en papel con datos reales (sin dinero)
# live  = opera con dinero real, PERO solo si el modelo pasó todas las pruebas (ver panel "Listo para real")
MODE=paper

# Clave de datos de PumpPortal (necesaria para ver compras/ventas). Requiere tener >= 0.02 SOL en su wallet.
PUMPPORTAL_API_KEY=

# De dónde salen los datos de pump.fun:
#   auto        = PumpPortal si hay clave; si no, la blockchain en tiempo real (gratis)
#   chain       = la blockchain en tiempo real: cada compra y venta al instante, con su wallet (gratis)
#   dexscreener = precios cada 10 s (gratis, sin datos por wallet; el modo antiguo)
DATA_SOURCE=auto
# Servidor para leer la blockchain. Vacío = el público de Solana. Si se corta a menudo, usa tu Helius:
# CHAIN_RPC=https://mainnet.helius-rpc.com/?api-key=TU_CLAVE  (vigila el consumo en el panel de Helius)
CHAIN_RPC=

# RPC de Solana (Helius gratis): https://mainnet.helius-rpc.com/?api-key=TU_CLAVE
# Solo hace falta para operar real y para ver el saldo de la wallet.
RPC_URL=

# Clave privada de la wallet DEL BOT (créala con: npm run wallet). Nunca uses tu wallet principal.
PRIVATE_KEY=

# --- Qué se considera un resultado ---
TP_PCT=0.60
SL_PCT=0.30
HORIZON_MIN=60

# Segundos que el bot observa cada lanzamiento antes de decidir
OBS_SECONDS=45
# Fracción de lanzamientos a seguir (1 = todos). Menos = menos mensajes y menor coste de datos.
TRACK_SAMPLE=0.5
MAX_TRACKED=400

# --- Decisión ---
# Además de a los 90 s, vuelve a evaluar cada token en estos segundos desde su lanzamiento (si sigue activo)
CHECKPOINTS=180,300,600
# EV neto mínimo tras costes para entrar (0.05 = +5%)
EV_MIN=0.05
GUARD_MAX_EARLY_SHARE=0.6
GUARD_MAX_TOP10=0.5
GUARD_MAX_DEV_SHARE=0.07
GUARD_MAX_CREATOR_PRIOR=5

# --- Cómo salir de una posición ---
# fixed  = todo a +60% / −30% / 60 min
# ladder = por partes: 50% a +25%, 25% a +60%, el resto con stop móvil; stop inicial −20%
# auto   = el bot simula las dos en papel y usa la que mejor resultado tenga
EXIT_STRATEGY=auto
LADDER_TP1=0.25
LADDER_TP1_FRAC=0.5
LADDER_TP2=0.60
LADDER_TP2_FRAC=0.25
LADDER_TRAIL=0.25
LADDER_STOP=0.20

# --- Cartera de prueba (dinero ficticio en euros, para ver resultados en tiempo real) ---
PAPER_START_EUR=50
PAPER_TRADE_EUR=5
PAPER_MAX_OPEN=5

# --- Límites de riesgo (dinero real) ---
MAX_SOL_PER_TRADE=0.03
MAX_OPEN=2
DAILY_LOSS_LIMIT_SOL=0.10
WALLET_RESERVE_SOL=0.02
SLIPPAGE_PCT=15
PRIORITY_FEE_SOL=0.0005

# --- Requisitos antes de permitir dinero real ---
MIN_LABELS_LIVE=1000
MIN_INFO_GAIN_LIVE=0.02
MIN_PAPER_TRADES_LIVE=30

# Comisión de pump.fun por lado (conservador)
PUMP_FEE=0.0125
PORT=8787
