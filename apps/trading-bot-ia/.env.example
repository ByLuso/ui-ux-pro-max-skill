# Copia este archivo a .env y rellena tus valores. Nunca subas .env a git.

# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Anthropic (analisis de Claude)
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-sonnet-5

# Capital que el bot puede gestionar, en EUR (solo dinero que puedes permitirte perder)
BOT_CAPITAL_EUR=0

# Telegram (alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard (opcional). Deja DASHBOARD_HOST=127.0.0.1 para solo tu maquina.
# Pon 0.0.0.0 para verlo desde el movil en la misma WiFi, y entonces define
# DASHBOARD_USERNAME/PASSWORD para que no quede abierto a toda la red.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
